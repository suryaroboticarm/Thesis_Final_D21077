@article{LIN2025110127,
title = {Robot path planning based on three-dimensional artificial potential field},
journal = {Engineering Applications of Artificial Intelligence},
volume = {144},
pages = {110127},
year = {2025},
issn = {0952-1976},
doi = {https://doi.org/10.1016/j.engappai.2025.110127},
url = {https://www.sciencedirect.com/science/article/pii/S0952197625001277},
author = {Hsien-I Lin and Muhammad Ahsan Fatwaddin Shodiq and Ming Feng Hsieh},
keywords = {Path planning, Three-dimensional artificial potential field, Force sensor, Robotic arm, Rotating repulsive force},
abstract = {Planning robot trajectories automatically using cameras or lasers is often challenging in numerous robotic manipulative tasks, as these technologies struggle to detect collisions between the tool tip and obstacles in narrow spaces. This paper proposes an innovative three-dimensional path planning method based on an artificial potential field in robotic manipulative tasks. This method senses the slight contact force from the obstacle through a force sensor installed at the end of the robotic arm that estimates the position of contact to avoid collisions. Different from ultrasonic and laser sensors, the force sensor can only obtain the force information of an obstacle point after contacting the obstacle. With such limited force information, the problem of falling into a local minimum of the artificial potential field tends to occur. To solve this problem and improve the three-dimensional space planning based on artificial potential field using force sensor, this paper proposes a three-dimensional artificial potential field. The direction of the rotating repulsive force field considers the forward directions of the tool and the path, thus the robot is able to successfully pass through narrow channels with overlapped repulsive force fields. Experiments have verified that the robotic arm that moves according to the path planning based on the three-dimensional artificial potential field can avoid the local minimum problem, as well as pass through a narrow channel smoothly. In addition, the robotic arm can obtain a smooth path after learning multiple artificial potential field paths.}}
