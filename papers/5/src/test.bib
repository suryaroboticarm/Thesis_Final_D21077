@Article{Health_robot,
AUTHOR = {Li, Yuan and Song, Hongkai and Ji, Yunfeng and Zhang, Lingling},
TITLE = {Path Planning Method and Control of Mobile Robot with Uncertain Dynamics Based on Improved Artificial Potential Field and Its Application in Health Monitoring},
JOURNAL = {Mathematics},
VOLUME = {12},
YEAR = {2024},
NUMBER = {19},
ARTICLE-NUMBER = {2965},
URL = {https://www.mdpi.com/2227-7390/12/19/2965},
ISSN = {2227-7390},
ABSTRACT = {To enhance the navigation and control efficiency of mobile robots in the field of health monitoring, a novel path planning and control strategy for mobile robots with uncertain dynamics based on improved artificial potential fields is proposed in this paper. Specifically, we propose an attractive potential field rotation method to overcome the limitation that traditional artificial potential fields tend to fall into local minima. Then, we define a new class of attractive potential fields to address the goals non-reachable with obstacles nearby (GNRON) and collisions caused by excessive attractive force at long distances from the target point. Furthermore, a control law is proposed for the mobile robot with uncertain dynamics, and the stability of the closed-loop system is rigorously proven using the Lyapunov method. Finally, the feasibility and effectiveness of the proposed method are verified by simulations and experiments.},
DOI = {10.3390/math12192965}
}
